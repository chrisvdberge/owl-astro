{
  // Cloudflare Workers static-assets deploy: serves the Vite build in ./dist; /api/* goes to the worker (data proxies)
  "name": "owl-astro",
  "compatibility_date": "2026-10-01",
  "main": "./worker/index.js",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  }
}
